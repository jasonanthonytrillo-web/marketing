{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "Enterprise POS System Backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node src/seed.js",
    "db:setup": "npx prisma db push && node src/seed.js",
    "backup:database": "node scripts/backup-database.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/client": "^6.8.2",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^6.8.2"
  }
}
