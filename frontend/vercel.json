{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "redirects": [
    { "source": "/share/:slug", "destination": "/api/share?slug=:slug", "permanent": false }
  ],
  "routes": [
    { "src": "/api/share", "dest": "/api/share" },
    { "src": "/api/public/(.*)", "dest": "https://marketing-pqi1.onrender.com/api/public/$1" },
    { "src": "/api/(.*)", "dest": "https://marketing-pqi1.onrender.com/api/$1" },
    { "src": "/uploads/(.*)", "dest": "https://marketing-pqi1.onrender.com/uploads/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
